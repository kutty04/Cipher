    "main": "src/server.js",
    "scripts": {
        "start": "node src/server.js",
        "dev": "nodemon src/server.js"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "express-rate-limit": "^8.5.2",
        "groq-sdk": "^0.7.0",
        "helmet": "^8.1.0",
        "openai": "^6.38.0",
        "pg": "^8.21.0"
    },
    "devDependencies": {
